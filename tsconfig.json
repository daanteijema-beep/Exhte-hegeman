{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "skills",
    "scripts",
    ".next",
    ".vercel",
    ".adal", ".agents", ".augment", ".claude", ".codebuddy", ".commandcode",
    ".continue", ".crush", ".factory", ".goose", ".iflow", ".junie",
    ".kilocode", ".kiro", ".kode", ".mcpjam", ".mux", ".neovate",
    ".openhands", ".pi", ".pochi", ".qoder", ".qwen", ".roo", ".trae",
    ".vibe", ".windsurf", ".zencoder"
  ]
}
